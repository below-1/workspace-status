---
import { fmtInt, fmtPct } from '../lib/format';
import type { TableColumn } from '../lib/table';
import { cn } from '../lib/utils';
import { Card, CardContent, CardDescription, CardHeader, CardTitle } from './ui/card';
import { Table, TableBody, TableCell, TableHead, TableHeader, TableRow } from './ui/table';

interface Props {
  title: string;
  description?: string;
  columns: TableColumn[];
  rows: Record<string, string | number>[];
}

const { title, description, columns, rows } = Astro.props;

function display(value: string | number | undefined, format: TableColumn['format'] = 'text') {
  if (value === undefined || value === null) return '—';
  if (format === 'int') return fmtInt(Number(value));
  if (format === 'pct' || format === 'progress') return fmtPct(Number(value));
  return String(value);
}

function clampPct(value: string | number | undefined): number {
  if (value === undefined || value === null) return 0;
  return Math.min(100, Math.max(0, Number(value)));
}
---

<Card>
  <CardHeader>
    <CardTitle>{title}</CardTitle>
    {description && <CardDescription>{description}</CardDescription>}
  </CardHeader>
  <CardContent>
    {
      rows.length ? (
        <Table>
          <TableHeader>
            <TableRow>
              {columns.map((column) => (
                <TableHead className={cn(column.align === 'right' && 'text-right')}>
                  {column.label}
                </TableHead>
              ))}
            </TableRow>
          </TableHeader>
          <TableBody>
            {rows.map((row) => (
              <TableRow>
                {columns.map((column) => (
                  <TableCell
                    className={cn(
                      (column.align === 'right' || column.format === 'progress') && 'text-right',
                      column.format === 'text' && 'font-medium',
                    )}
                  >
                    {column.format === 'progress' ? (
                      <div class="flex items-center justify-end gap-3">
                        <div
                          class="hidden h-1.5 w-16 overflow-hidden rounded-full bg-muted sm:block"
                          aria-hidden="true"
                        >
                          <div
                            class="h-full rounded-full bg-primary"
                            style={`width: ${clampPct(row[column.key])}%`}
                          />
                        </div>
                        <span class="tabular-nums">{display(row[column.key], column.format)}</span>
                      </div>
                    ) : (
                      display(row[column.key], column.format)
                    )}
                  </TableCell>
                ))}
              </TableRow>
            ))}
          </TableBody>
        </Table>
      ) : (
        <div class="flex h-24 items-center justify-center rounded-lg border border-dashed text-sm text-muted-foreground">
          Belum ada data.
        </div>
      )
    }
  </CardContent>
</Card>
