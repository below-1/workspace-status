---
interface Props {
  eyebrow: string;
  title: string;
  description: string;
  generated: string;
  backHref?: string;
  backLabel?: string;
}

const { eyebrow, title, description, generated, backHref, backLabel } = Astro.props;
---

<header class="mb-12">
  {
    backHref && (
      <a href={backHref} class="mb-6 inline-flex text-sm font-medium text-primary hover:underline">
        ← {backLabel ?? 'Kembali'}
      </a>
    )
  }
  <div class="flex flex-wrap items-center gap-x-3 gap-y-2">
    <p class="text-xs font-semibold uppercase tracking-[0.16em] text-primary">{eyebrow}</p>
    <span class="inline-flex items-center rounded-full bg-primary-soft px-2.5 py-1 text-xs font-medium text-primary-soft-foreground">
      Dihasilkan {generated}
    </span>
  </div>
  <h1 class="mt-3 text-3xl font-semibold tracking-tight sm:text-4xl">{title}</h1>
  <p class="mt-4 max-w-3xl text-sm text-muted-foreground sm:text-base">{description}</p>
</header>
