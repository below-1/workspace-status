---
import '@fontsource/inter/400.css';
import '@fontsource/inter/600.css';
import '../styles/globals.css';

import ThemeToggle from '../components/ThemeToggle';

interface Props {
  title: string;
  description: string;
  pageLabel?: string;
  fullHeight?: boolean;
  fullBleed?: boolean;
  footerNote?: string;
}

const {
  title,
  description,
  pageLabel,
  fullHeight = false,
  fullBleed = false,
  footerNote = 'Data agregat hasil olahan.',
} = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const path = Astro.url.pathname;
const isHome = path === base || path === base.replace(/\/$/, '') || path === '/';
const parent = `${base}status-rekapitulasi-pppk-paruh-waktu/`;
const shell = 'mx-auto w-full max-w-[1200px] px-4 sm:px-8';
const links = [
  {
    href: parent,
    label: 'Rekapitulasi',
    active: path === parent || path === parent.replace(/\/$/, ''),
  },
  { href: `${parent}pendidikan/`, label: 'Pendidikan', active: path.startsWith(`${parent}pendidikan/`) },
  {
    href: `${parent}non-pendidikan/`,
    label: 'Non-Pendidikan',
    active: path.startsWith(`${parent}non-pendidikan/`),
  },
  { href: `${parent}status-nip/`, label: 'NIP', active: path.startsWith(`${parent}status-nip/`) },
  {
    href: `${parent}status-unit-email/`,
    label: 'Email',
    active: path.startsWith(`${parent}status-unit-email/`),
  },
];
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <link rel="icon" href={`${base}favicon.png`} type="image/png" sizes="64x64" />
    <link rel="apple-touch-icon" href={`${base}apple-touch-icon.png`} />
    <script is:inline>
      (() => {
        try {
          const saved = localStorage.getItem('theme');
          const dark = saved
            ? saved === 'dark'
            : window.matchMedia('(prefers-color-scheme: dark)').matches;
          document.documentElement.classList.toggle('dark', dark);
        } catch (_) {}
      })();
    </script>
  </head>
  <body class:list={['min-h-screen', fullHeight && 'flex flex-col']}>
    <a
      href="#content"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-md focus:bg-primary focus:px-3 focus:py-2 focus:text-primary-foreground"
    >
      Lewati ke konten
    </a>

    <header class="sticky top-0 z-40 border-b bg-card/90 backdrop-blur">
      <div class:list={[shell, 'flex items-center gap-4 py-4']}>
        <a href={`${base}`} class="flex items-center gap-3" aria-label="BKD - Status Data — beranda">
          <img
            src={`${base}brand/ntt-crest.png`}
            alt=""
            aria-hidden="true"
            class="size-9 shrink-0 object-contain sm:size-10"
          />
          <span class="flex flex-col leading-tight">
            <span class="text-base font-semibold tracking-tight">BKD - Status Data</span>
            <span class="text-xs text-muted-foreground">Ringkasan Hasil Olahan Data</span>
          </span>
        </a>
        {!isHome && <nav class="ml-auto hidden items-center gap-1 sm:flex" aria-label="Navigasi utama">
          {
            links.map((link) => (
              <a
                href={link.href}
                aria-current={link.active ? 'page' : undefined}
                class:list={[
                  'relative px-3 py-2 text-sm transition-colors after:absolute after:inset-x-3 after:-bottom-px after:h-0.5',
                  link.active
                    ? 'font-medium text-primary after:bg-primary'
                    : 'text-muted-foreground after:bg-transparent hover:text-foreground hover:after:bg-border',
                ]}
              >
                {link.label}
              </a>
            ))
          }
        </nav>}
        <div class="ml-auto shrink-0 sm:ml-0"><ThemeToggle client:idle /></div>
      </div>
      {!isHome && <div class:list={[shell, 'flex gap-2 overflow-x-auto pb-3 sm:hidden']} aria-label="Navigasi">
        {
          links.map((link) => (
            <a
              href={link.href}
              aria-current={link.active ? 'page' : undefined}
              class:list={[
                'shrink-0 border-b-2 px-3 py-1.5 text-xs transition-colors',
                link.active
                  ? 'border-primary font-medium text-primary'
                  : 'border-transparent text-muted-foreground hover:text-foreground',
              ]}
            >
              {link.label}
            </a>
          ))
        }
      </div>}
    </header>

    <main
      id="content"
      class:list={[
        !fullBleed && shell,
        !fullBleed && 'py-12 sm:py-16',
        fullHeight && 'flex flex-1 flex-col justify-center',
      ]}
    >
      {pageLabel && <p class="mb-4 text-xs font-semibold uppercase tracking-widest text-primary">{pageLabel}</p>}
      <slot />
    </main>

    <footer class="border-t py-10">
      <div class:list={[shell, 'flex flex-col gap-1 py-1 text-xs text-muted-foreground sm:flex-row sm:items-center']}>
        <span>{footerNote}</span>
        <span class="sm:ml-auto">Dihasilkan dari pipeline internal.</span>
      </div>
    </footer>
  </body>
</html>
