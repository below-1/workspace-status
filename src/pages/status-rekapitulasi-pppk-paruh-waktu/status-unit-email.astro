---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import EmailLogTable from '../../components/tables/EmailLogTable';
import data from '../../data/paruh-status-unit-email.json';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const dataVersion = encodeURIComponent(data.meta.generated_at);
const nipPageUrl = `${base}status-rekapitulasi-pppk-paruh-waktu/status-nip/`;
---

<BaseLayout
  title="Status email masuk PPPK Paruh Waktu | BKD - Status Data"
  description="Cari status email masuk berdasarkan alamat email pengirim."
>
  <PageHeader
    eyebrow={`PPPK Paruh Waktu · Periode ${data.meta.period}`}
    title="Status Email Masuk"
    description="Masukkan alamat email pengirim secara lengkap untuk melihat hasil validasi berkas yang dikirim."
    generated={data.meta.generated_at}
    backHref={`${base}status-rekapitulasi-pppk-paruh-waktu/`}
    backLabel="Kembali ke ringkasan"
  />

  <div class="mb-6 rounded-xl border bg-muted/40 p-4 text-sm text-muted-foreground">
    <p class="font-medium text-foreground">Email dengan subjek tidak sesuai tidak diproses.</p>
    <p class="mt-1">
      Sistem hanya memproses email dengan subjek rekap evaluasi PPPK paruh waktu 2026 yang
      sesuai. Jika email Anda tidak muncul, periksa kembali subjek dan alamat tujuan email,
      lalu kirim ulang ke alamat inbox yang benar.
    </p>
  </div>

  <EmailLogTable
    client:visible
    dataUrl={`${base}data/paruh-email-log.json?v=${dataVersion}`}
    lookupUrl={`${base}data/paruh-nip-lookup.json?v=${dataVersion}`}
    nipPageUrl={nipPageUrl}
  />

  <p class="mt-8 text-xs text-muted-foreground">
    Sumber: email inbox-pk. Halaman ini memvalidasi email, bukan unit kerja. Alamat email
    pengirim ditampilkan; nama pengirim, subjek, dan nama berkas tidak ditampilkan.
  </p>
</BaseLayout>
