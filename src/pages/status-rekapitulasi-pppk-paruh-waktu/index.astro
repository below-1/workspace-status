---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import KpiCards from '../../components/KpiCards.astro';
import { Card, CardContent, CardDescription, CardHeader, CardTitle } from '../../components/ui/card';
import { fmtInt, fmtPct } from '../../lib/format';
import data from '../../data/paruh-waktu.json';
import nipData from '../../data/paruh-status-nip.json';
import emailData from '../../data/paruh-status-unit-email.json';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const { summary } = data;
const hrefs: Record<string, string> = {
  pendidikan: `${base}status-rekapitulasi-pppk-paruh-waktu/pendidikan/`,
  'non-pendidikan': `${base}status-rekapitulasi-pppk-paruh-waktu/non-pendidikan/`,
};
const descriptions: Record<string, string> = {
  pendidikan: 'Sekolah dan unit induk di bawah Dinas Pendidikan dan Kebudayaan.',
  'non-pendidikan': 'Unit kerja di luar Dinas Pendidikan dan Kebudayaan.',
};

function scope(group: (typeof summary.groups)[number]): string {
  return group.key === 'pendidikan'
    ? `${fmtInt(group.satuan_kerja_count)} satuan kerja`
    : `${fmtInt(group.unit_count)} unit kerja`;
}
---

<BaseLayout
  title="Status rekapitulasi data evaluasi PPPK Paruh Waktu | BKD - Status Data"
  description="Status rekapitulasi data evaluasi PPPK paruh waktu tahun 2026."
>
  <PageHeader
    eyebrow={`PPPK Paruh Waktu · Periode ${data.meta.period}`}
    title="Ringkasan PPPK paruh waktu provinsi"
    description="Monitoring progres pengisian data PPPK Paruh Waktu di lingkungan Pemerintah Provinsi NTT."
    generated={data.meta.generated_at}
  />

  <KpiCards
    items={[
      {
        label: 'Total master',
        value: fmtInt(summary.total),
        hint: 'PPPK paruh waktu provinsi',
        icon: 'total',
      },
      {
        label: 'Sudah masuk',
        value: fmtInt(summary.processed),
        hint: `${fmtPct(summary.ratio)} dari total master`,
        tone: 'success',
        icon: 'processed',
        progress: summary.ratio,
      },
      {
        label: 'Belum',
        value: fmtInt(summary.belum),
        hint: 'Perlu tindak lanjut',
        tone: 'danger',
        icon: 'pending',
        progress: 100 - summary.ratio,
      },
      {
        label: 'Persentase',
        value: fmtPct(summary.ratio),
        hint: `${fmtInt(summary.unregistered)} usulan tak terdaftar`,
        tone: 'primary',
        icon: 'ratio',
        progress: summary.ratio,
      },
    ]}
  />

  <section class="mt-12 grid gap-6 md:grid-cols-2" aria-label="Ringkasan per kelompok">
    {
      summary.groups.map((group) => (
        <a
          href={hrefs[group.key]}
          class="group block rounded-xl focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-background"
        >
          <Card className="h-full transition-colors group-hover:border-primary group-focus-visible:border-primary">
            <CardHeader>
              <CardTitle className="text-lg">{group.title}</CardTitle>
              <CardDescription>{descriptions[group.key]}</CardDescription>
            </CardHeader>
            <CardContent>
              <div class="flex items-baseline gap-2">
                <span class="text-3xl font-semibold tabular-nums text-primary">{fmtPct(group.ratio)}</span>
                <span class="text-sm text-muted-foreground">sudah masuk</span>
              </div>
              <div class="mt-4 h-2.5 w-full overflow-hidden rounded-full bg-muted" aria-hidden="true">
                <div
                  class="h-full rounded-full bg-primary"
                  style={`width: ${Math.min(100, Math.max(0, group.ratio))}%`}
                />
              </div>
              <p class="mt-4 text-sm text-muted-foreground">
                <span class="font-medium text-foreground">{fmtInt(group.processed)}</span> dari{' '}
                {fmtInt(group.total)} orang · {scope(group)}
              </p>
              <p class="mt-5 inline-flex text-sm font-medium text-primary">Lihat ringkasan →</p>
            </CardContent>
          </Card>
        </a>
      ))
    }
  </section>


  <section class="mt-12" aria-labelledby="pemeriksaan-data">
    <div class="mb-5">
      <h2 id="pemeriksaan-data" class="text-lg font-semibold">Pemeriksaan data</h2>
      <p class="mt-1 text-sm text-muted-foreground">
        Cek status per NIP atau lihat email masuk yang tidak dapat dipakai.
      </p>
    </div>
    <div class="grid gap-6 md:grid-cols-2">
      <a
        href={`${base}status-rekapitulasi-pppk-paruh-waktu/status-nip/`}
        class="group block rounded-xl focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-background"
      >
        <Card className="h-full transition-colors group-hover:border-primary group-focus-visible:border-primary">
          <CardHeader>
            <CardTitle className="text-lg">Status NIP</CardTitle>
            <CardDescription>Cek status usulan berdasarkan NIP.</CardDescription>
          </CardHeader>
          <CardContent>
            <p class="text-sm text-muted-foreground">
              <span class="font-medium text-foreground">{fmtInt(nipData.summary.valid)}</span> berkas valid ·{' '}
              <span class="font-medium text-foreground">{fmtInt(nipData.summary.needs_fix)}</span> perlu perbaikan ·{' '}
              <span class="font-medium text-foreground">{fmtInt(nipData.summary.not_submitted)}</span> belum ada usulan
            </p>
            <p class="mt-5 inline-flex text-sm font-medium text-primary">Cek status NIP →</p>
          </CardContent>
        </Card>
      </a>
      <a
        href={`${base}status-rekapitulasi-pppk-paruh-waktu/status-unit-email/`}
        class="group block rounded-xl focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-background"
      >
        <Card className="h-full transition-colors group-hover:border-primary group-focus-visible:border-primary">
          <CardHeader>
            <CardTitle className="text-lg">Status email masuk</CardTitle>
            <CardDescription>Cek apakah email dan berkas yang dikirim sudah diproses.</CardDescription>
          </CardHeader>
          <CardContent>
            <p class="text-sm text-muted-foreground">
              <span class="font-medium text-foreground">{fmtInt(emailData.summary.emails)}</span> email ·{' '}
              <span class="font-medium text-foreground">{fmtInt(emailData.summary.failed)}</span> bermasalah ·{' '}
              <span class="font-medium text-foreground">{fmtInt(emailData.summary.valid_files)}</span> berkas valid
            </p>
            <p class="mt-5 inline-flex text-sm font-medium text-primary">Lihat status email →</p>
          </CardContent>
        </Card>
      </a>
    </div>
  </section>

  <section class="mt-12 max-w-3xl rounded-xl border bg-muted/50 p-7 text-sm text-muted-foreground">
    <h2 class="mb-3 text-sm font-semibold text-foreground">Cara membaca</h2>
    <ul class="list-disc space-y-1 pl-5">
      <li>Angka dihitung dari daftar resmi PPPK paruh waktu yang sudah dikelompokkan.</li>
      <li>“Sudah masuk” berarti NIP ditemukan pada usulan terbaru yang dapat dipakai.</li>
      <li>Usulan dengan NIP tidak terdaftar dihitung terpisah dan tidak menambah capaian.</li>
    </ul>
  </section>
</BaseLayout>
