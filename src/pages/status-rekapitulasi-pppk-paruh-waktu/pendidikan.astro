---
import BaseLayout from '../../layouts/BaseLayout.astro';
import KpiCards from '../../components/KpiCards.astro';
import StatTable from '../../components/StatTable.astro';
import { Card, CardContent, CardDescription, CardHeader, CardTitle } from '../../components/ui/card';
import { fmtInt, fmtPct } from '../../lib/format';
import type { TableColumn } from '../../lib/table';
import data from '../../data/paruh-pendidikan.json';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const { summary } = data;
const share = summary.province.total ? (summary.total / summary.province.total) * 100 : 0;

const bucketColumns: TableColumn[] = [
  { key: 'name', label: 'Jenjang / satuan kerja' },
  { key: 'total', label: 'Jumlah', format: 'int', align: 'right' },
  { key: 'processed', label: 'Sudah masuk', format: 'int', align: 'right' },
  { key: 'belum', label: 'Belum', format: 'int', align: 'right' },
  { key: 'ratio', label: 'Persentase', format: 'pct', align: 'right' },
];

const invalidColumns: TableColumn[] = [
  { key: 'unit', label: 'Unit kerja' },
  { key: 'reason', label: 'Alasan' },
  { key: 'count', label: 'Pengirim', format: 'int', align: 'right' },
];
---

<BaseLayout
  title="PPPK Paruh Waktu — Pendidikan | Workspace Status"
  description="Ringkasan status usulan perpanjangan PPPK paruh waktu Dinas Pendidikan dan Kebudayaan tahun 2026."
  pageLabel="PPPK Paruh Waktu"
>
  <header class="mb-6">
    <a href={`${base}status-rekapitulasi-pppk-paruh-waktu/`} class="text-sm text-primary hover:underline">
      ← Kembali ke ringkasan
    </a>
    <h1 class="mt-3 text-3xl font-semibold sm:text-4xl">{data.meta.title}</h1>
    <p class="mt-2 text-sm text-muted-foreground">
      Periode {data.meta.period} · Terakhir diperbarui {data.meta.generated_at} · Sumber data
      {data.meta.source_updated_at}
    </p>
  </header>

  <KpiCards
    items={[
      { label: 'Total master', value: fmtInt(summary.total) },
      { label: 'Sudah masuk', value: fmtInt(summary.processed), tone: 'success' },
      { label: 'Belum', value: fmtInt(summary.belum), tone: 'danger' },
      { label: 'Persentase', value: fmtPct(summary.ratio) },
    ]}
  />

  <section class="mt-6 grid gap-4 lg:grid-cols-[minmax(0,1fr)_minmax(0,2fr)]">
    <Card>
      <CardHeader>
        <CardTitle>Konteks singkat</CardTitle>
        <CardDescription>Kelompok Dinas Pendidikan dan Kebudayaan.</CardDescription>
      </CardHeader>
      <CardContent className="space-y-2 text-sm text-muted-foreground">
        <p>
          Secara provinsi, <span class="font-medium text-foreground">{fmtInt(summary.province.processed)}</span>
          dari {fmtInt(summary.province.total)} PPPK paruh waktu ({fmtPct(summary.province.ratio)})
          sudah masuk daftar.
        </p>
        <p>
          Kelompok ini mencakup {fmtPct(share)} dari seluruh paruh waktu provinsi, dengan
          {fmtInt(summary.satuan_kerja_count)} satuan kerja.
        </p>
        <p class="text-xs">
          {fmtInt(summary.unregistered)} baris usulan dengan NIP tak terdaftar tidak dihitung sebagai
          sudah masuk.
        </p>
      </CardContent>
    </Card>
    <Card className="flex flex-col justify-center">
      <CardHeader>
        <CardTitle>Rincian status</CardTitle>
        <CardDescription>
          Tabel lengkap berisi {fmtInt(summary.satuan_kerja_count)} satuan kerja: pencarian, filter
          jenjang dan status, pengurutan, serta unduhan CSV.
        </CardDescription>
      </CardHeader>
      <CardContent>
        <a
          href={`${base}status-rekapitulasi-pppk-paruh-waktu/pendidikan/satuan-kerja/`}
          class="inline-flex items-center rounded-md bg-primary px-4 py-2 text-sm font-medium text-primary-foreground hover:bg-primary/90"
        >
          Lihat status per satuan kerja →
        </a>
      </CardContent>
    </Card>
  </section>

  <div class="mt-8 space-y-8">
    <StatTable
      title="Per jenjang"
      columns={bucketColumns}
      rows={data.jenjang}
      description="Lima kelompok jenjang pada daftar resmi PPPK paruh waktu."
    />
    <StatTable
      title="Satuan kerja terbesar"
      columns={bucketColumns}
      rows={data.satuan_kerja.slice(0, 5)}
      description="Lima satuan kerja dengan jumlah PPPK paruh waktu paling banyak. Rincian lengkap ada di halaman berikutnya."
    />

    <details class="rounded-xl border bg-card p-5 text-sm">
      <summary class="cursor-pointer font-semibold">Catatan metodologi dan pengirim bermasalah</summary>
      <div class="mt-4 space-y-6">
        <ul class="list-disc space-y-1 pl-5 text-muted-foreground">
          <li>Pencocokan per NIP terhadap daftar resmi PPPK paruh waktu.</li>
          <li>Jika satu NIP dikirim berulang, usulan dari email terbaru yang dipakai.</li>
          <li>Usulan dengan NIP tidak valid tidak menambah jumlah “sudah masuk”.</li>
          <li>Angka dibulatkan dua angka desimal; jumlah orang tetap menggunakan bilangan bulat.</li>
        </ul>
        <StatTable
          title="Pengirim dengan usulan terakhir yang tidak dapat dipakai"
          columns={invalidColumns}
          rows={data.invalid_submissions}
          description="Diringkas per unit kerja dan alasan; tanpa alamat email."
        />
      </div>
    </details>
  </div>
</BaseLayout>
