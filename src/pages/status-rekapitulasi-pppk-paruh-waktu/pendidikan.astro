---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import KpiCards from '../../components/KpiCards.astro';
import ProgressSummary from '../../components/ProgressSummary.astro';
import StatTable from '../../components/StatTable.astro';
import SatuanKerjaTable from '../../components/tables/SatuanKerjaTable';
import { Card, CardContent, CardDescription, CardHeader, CardTitle } from '../../components/ui/card';
import { fmtInt, fmtPct } from '../../lib/format';
import type { TableColumn } from '../../lib/table';
import data from '../../data/paruh-pendidikan.json';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const { summary } = data;
const share = summary.province.total ? (summary.total / summary.province.total) * 100 : 0;

const counts = data.satuan_kerja.reduce(
  (acc, row) => {
    if (!row.total || !row.processed) acc.kosong += 1;
    else if (row.processed >= row.total) acc.lengkap += 1;
    else acc.sebagian += 1;
    return acc;
  },
  { lengkap: 0, sebagian: 0, kosong: 0 },
);

const bucketColumns: TableColumn[] = [
  { key: 'name', label: 'Jenjang / satuan kerja' },
  { key: 'total', label: 'Jumlah', format: 'int', align: 'right' },
  { key: 'processed', label: 'Sudah masuk', format: 'int', align: 'right' },
  { key: 'belum', label: 'Belum', format: 'int', align: 'right' },
  { key: 'ratio', label: 'Progres', format: 'progress', align: 'right' },
];

const invalidColumns: TableColumn[] = [
  { key: 'unit', label: 'Unit kerja' },
  { key: 'reason', label: 'Alasan' },
  { key: 'count', label: 'Pengirim', format: 'int', align: 'right' },
];
---

<BaseLayout
  title="PPPK Paruh Waktu — Pendidikan | BKD - Status Data"
  description="Ringkasan status usulan perpanjangan PPPK paruh waktu Dinas Pendidikan dan Kebudayaan tahun 2026."
>
  <PageHeader
    eyebrow={`PPPK Paruh Waktu · Periode ${data.meta.period}`}
    title="Pendidikan"
    description="Monitoring progres pengisian data PPPK Paruh Waktu pada satuan kerja di bawah Dinas Pendidikan dan Kebudayaan di lingkungan Pemerintah Provinsi NTT."
    generated={data.meta.generated_at}
    backHref={`${base}status-rekapitulasi-pppk-paruh-waktu/`}
    backLabel="Kembali ke ringkasan"
  />

  <KpiCards
    items={[
      { label: 'Total master', value: fmtInt(summary.total), icon: 'total' },
      {
        label: 'Sudah masuk',
        value: fmtInt(summary.processed),
        hint: `${fmtPct(summary.ratio)} dari total master`,
        tone: 'success',
        icon: 'processed',
        progress: summary.ratio,
      },
      {
        label: 'Belum',
        value: fmtInt(summary.belum),
        hint: 'Perlu tindak lanjut',
        tone: 'danger',
        icon: 'pending',
        progress: 100 - summary.ratio,
      },
      {
        label: 'Persentase',
        value: fmtPct(summary.ratio),
        tone: 'primary',
        icon: 'ratio',
        progress: summary.ratio,
      },
    ]}
  />

  <div class="mt-10">
    <ProgressSummary
      ratio={summary.ratio}
      processed={summary.processed}
      total={summary.total}
      counts={counts}
      unitLabel="satuan kerja"
      contextDescription="Kelompok Dinas Pendidikan dan Kebudayaan."
    >
      <p>
        Secara provinsi, <span class="font-medium text-foreground">{fmtInt(summary.province.processed)}</span>
        dari {fmtInt(summary.province.total)} PPPK paruh waktu ({fmtPct(summary.province.ratio)})
        sudah masuk daftar.
      </p>
      <p>
        Kelompok ini mencakup {fmtPct(share)} dari seluruh paruh waktu provinsi, dengan
        {fmtInt(summary.satuan_kerja_count)} satuan kerja.
      </p>
      <p class="text-xs">
        {fmtInt(summary.unregistered)} baris usulan dengan NIP tak terdaftar tidak dihitung sebagai
        sudah masuk.
      </p>
    </ProgressSummary>
  </div>

  <div class="mt-12 space-y-12">
    <StatTable
      title="Per jenjang"
      columns={bucketColumns}
      rows={data.jenjang}
      description="Lima kelompok jenjang pada daftar resmi PPPK paruh waktu."
    />

    <Card>
      <CardHeader>
        <CardTitle>Status satuan kerja</CardTitle>
        <CardDescription>
          <span class="font-medium text-foreground">{fmtInt(counts.lengkap)} lengkap</span> ·{' '}
          <span class="font-medium text-foreground">{fmtInt(counts.sebagian)} sebagian</span> ·{' '}
          <span class="font-medium text-foreground">{fmtInt(counts.kosong)} kosong</span>. Cari nama
          satuan kerja, saring berdasarkan jenjang atau status, lalu urutkan kolom yang diinginkan.
        </CardDescription>
      </CardHeader>
      <CardContent>
        <SatuanKerjaTable client:visible rows={data.satuan_kerja} />
      </CardContent>
    </Card>

    <details class="rounded-xl border bg-card p-7 text-sm">
      <summary class="cursor-pointer font-semibold">Catatan metodologi dan pengirim bermasalah</summary>
      <div class="mt-5 space-y-8">
        <ul class="list-disc space-y-1 pl-5 text-muted-foreground">
          <li>Pencocokan per NIP terhadap daftar resmi PPPK paruh waktu.</li>
          <li>Jika satu NIP dikirim berulang, usulan dari email terbaru yang dipakai.</li>
          <li>Usulan dengan NIP tidak valid tidak menambah jumlah “sudah masuk”.</li>
          <li>Angka dibulatkan dua angka desimal; jumlah orang tetap menggunakan bilangan bulat.</li>
        </ul>
        <StatTable
          title="Pengirim dengan usulan terakhir yang tidak dapat dipakai"
          columns={invalidColumns}
          rows={data.invalid_submissions}
          description="Diringkas per unit kerja dan alasan; tanpa alamat email."
        />
      </div>
    </details>
  </div>
</BaseLayout>
